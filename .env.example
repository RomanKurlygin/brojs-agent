# --- KFU Course Agent: скопируй в .env и подставь свои значения ---

# LLM (OpenRouter) — https://openrouter.ai/settings/keys
OPENAI_API_KEY=YOUR_OPENROUTER_KEY_HERE

# Журнал BroJS — platform.brojs.ru, раздел API-токенов
JOURNAL_TOKEN=YOUR_JOURNAL_TOKEN_HERE

# Gitea — git.brojs.ru → Settings → Applications → Generate Token
GITEA_TOKEN=YOUR_GITEA_TOKEN_HERE
# Логин на git.brojs.ru (Settings → Account → имя пользователя)
GITEA_OWNER=YOUR_GITEA_USERNAME_HERE

# Web search (необязательно) — https://tavily.com
TAVILY_API_KEY=
